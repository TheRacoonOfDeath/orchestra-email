msgstr "Diese Platzhalter werden für jeden Empfänger ersetzt:"

#: src/Ui/AutomaticEmailsView.php:145
msgid "Replace your text with the default text?"
msgstr "Deinen Text durch den Standardtext ersetzen?"

#: src/Ui/AutomaticEmailsView.php:147
msgid "Reset to default"
msgstr "Auf Standard zurücksetzen"

