#: src/Admin/ComposePage.php:54 src/Admin/ComposePage.php:55 src/Plugin.php:113
msgid "Email"
msgstr "E-Mail"

#: src/Admin/ComposePage.php:64 src/Admin/ComposePage.php:65
#: src/Admin/ComposePage.php:86 src/Admin/ComposePage.php:101
msgid "Write Email"
msgstr "E-Mail schreiben"

#: src/Admin/ComposePage.php:72 src/Admin/ComposePage.php:73
#: src/Admin/ComposePage.php:98
msgid "Sent Emails"
msgstr "Gesendete E-Mails"

#. translators: 1: file name, 2: list of allowed file extensions
#: src/Attachment/AttachmentService.php:83
#, php-format
msgid "\"%1$s\" has a file type that cannot be attached. Allowed types: %2$s."
msgstr ""
"„%1$s“ hat einen Dateityp, der nicht angehängt werden kann. Erlaubte Typen: "
"%2$s."

#. translators: %s: file name
#: src/Attachment/AttachmentService.php:97
#, php-format
msgid "\"%s\" could not be stored."
msgstr "„%s“ konnte nicht gespeichert werden."

#. translators: %d: maximum number of attachments
#: src/Attachment/AttachmentService.php:131
#, php-format
msgid "An email can have at most %d attachments."
msgstr "Eine E-Mail kann höchstens %d Anhänge haben."

#. translators: %s: maximum size, e.g. "10 MB"
#: src/Attachment/AttachmentService.php:137
#, php-format
msgid "The attachments must not be larger than %s in total."
msgstr "Die Anhänge dürfen insgesamt nicht größer als %s sein."

#. translators: %s: file name
#: src/Attachment/AttachmentService.php:291
#, php-format
msgid "\"%s\" is larger than the maximum upload size."
msgstr "„%s“ ist größer als die maximale Upload-Größe."

#. translators: %s: file name
#: src/Attachment/AttachmentService.php:294
#, php-format
msgid "\"%s\" could not be uploaded."
msgstr "„%s“ konnte nicht hochgeladen werden."

#. translators: %s: file name
#: src/Attachment/AttachmentService.php:296
#, php-format
msgid "\"%s\" is empty."
msgstr "„%s“ ist leer."

#: src/EmailDraft.php:80
msgid "Please enter a subject."
msgstr "Bitte gib einen Betreff ein."

#. translators: %d: maximum number of characters
#: src/EmailDraft.php:83
#, php-format
msgid "The subject must not be longer than %d characters."
msgstr "Der Betreff darf höchstens %d Zeichen lang sein."

#: src/EmailDraft.php:87
msgid "Please enter a message."
msgstr "Bitte gib eine Nachricht ein."

#. translators: %d: maximum number of characters
#: src/EmailDraft.php:90
#, php-format
msgid "The message must not be longer than %d characters."
msgstr "Die Nachricht darf höchstens %d Zeichen lang sein."

#: src/EmailDraft.php:94
msgid "Please enter a valid email address for replies."
msgstr "Bitte gib eine gültige E-Mail-Adresse für Antworten ein."

#: src/EmailSender.php:107 src/Ui/EmailView.php:121
msgid "Former member"
msgstr "Ehemaliges Mitglied"

#: src/EmailService.php:108
msgid "An attachment is no longer available. Please add it again."
msgstr "Ein Anhang ist nicht mehr verfügbar. Bitte füge ihn erneut hinzu."

#: src/EmailService.php:112
msgid "Please select at least one group."
msgstr "Bitte wähle mindestens eine Gruppe aus."

#: src/EmailService.php:119
msgid "You are not allowed to email one of the selected groups."
msgstr "Du darfst einer der ausgewählten Gruppen keine E-Mails schreiben."

#: src/EmailService.php:124
msgid "The selected groups have no recipients."
msgstr "Die ausgewählten Gruppen haben keine Empfänger."

#. translators: 1: sender name, 2: site name, 3: list of recipient groups
#: src/MessageFormatter.php:63
#, php-format
msgid "Sent by %1$s via %2$s to: %3$s"
msgstr "Gesendet von %1$s über %2$s an: %3$s"

#: src/Plugin.php:114
msgid "Write to members, sections and project participants."
msgstr "Schreibe an Mitglieder, Register und Projektteilnehmer."

#: src/Plugin.php:158
msgid ""
"Orchestra Email needs Orchestra Core 0.7 or later. Please update Orchestra "
"Core; until then, Orchestra Core sends the emails itself."
msgstr ""
"Orchestra Email braucht Orchestra Core 0.7 oder neuer. Bitte aktualisiere "
"Orchestra Core; bis dahin verschickt Orchestra Core die E-Mails selbst."

#: src/Plugin.php:162
msgid "Orchestra Email needs Orchestra Core. Please install and activate it."
msgstr ""
"Orchestra Email braucht Orchestra Core. Bitte installiere und aktiviere es."

#: src/Ui/EmailShortcode.php:34
msgid "Please log in to write emails."
msgstr "Bitte melde dich an, um E-Mails zu schreiben."

#: src/Ui/EmailShortcode.php:37
msgid "You are not allowed to send emails."
msgstr "Du darfst keine E-Mails senden."

#: src/Ui/EmailShortcode.php:45
msgid "Sent emails"
msgstr "Gesendete E-Mails"

#: src/Ui/EmailShortcode.php:45
msgid "Write email"
msgstr "E-Mail schreiben"

#. translators: %s: maximum size, e.g. "10 MB"
#: src/Ui/EmailView.php:64
#, php-format
msgid "The attachments are too large. At most %s can be uploaded at once."
msgstr ""
"Die Anhänge sind zu groß. Es können höchstens %s auf einmal hochgeladen "
"werden."

#. translators: %d: number of recipients
#: src/Ui/EmailView.php:96
#, php-format
msgid "Your email has been sent to %d recipients."
msgstr "Deine E-Mail wurde an %d Empfänger gesendet."

#. translators: %d: number of recipients
#: src/Ui/EmailView.php:98
#, php-format
msgid ""
"Your email is being sent to %d recipients. Large groups take a few minutes."
msgstr ""
"Deine E-Mail wird an %d Empfänger gesendet. Bei großen Gruppen dauert das "
"einige Minuten."

#: src/Ui/EmailView.php:108
msgid "Sent"
msgstr "Gesendet"

#. translators: 1: number of sent emails, 2: number of recipients
#: src/Ui/EmailView.php:111
#, php-format
msgid "Sending (%1$d of %2$d)"
msgstr "Wird gesendet (%1$d von %2$d)"

#. translators: %d: number of emails that could not be sent
#: src/Ui/EmailView.php:117
#, php-format
msgid "%d failed"
msgstr "%d fehlgeschlagen"

#: src/Ui/EmailView.php:131
msgid "Date"
msgstr "Datum"

#: src/Ui/EmailView.php:132
msgid "Sender"
msgstr "Absender"

#: src/Ui/EmailView.php:133 src/Ui/EmailView.php:189 src/Ui/EmailView.php:241
msgid "Subject"
msgstr "Betreff"

#: src/Ui/EmailView.php:134 src/Ui/EmailView.php:227
msgid "Groups"
msgstr "Gruppen"

#: src/Ui/EmailView.php:135 src/Ui/EmailView.php:153 src/Ui/EmailView.php:229
msgid "Recipients"
msgstr "Empfänger"

#: src/Ui/EmailView.php:136
msgid "Status"
msgstr "Status"

#: src/Ui/EmailView.php:139
msgid "No emails have been sent yet."
msgstr "Es wurden noch keine E-Mails gesendet."

#. translators: %d: number of days
#: src/Ui/EmailView.php:142
#, php-format
msgid ""
"Texts are deleted once sent. The log shows who emailed which groups for %d "
"days."
msgstr ""
"Die Texte werden nach dem Versand gelöscht. Das Protokoll zeigt %d Tage "
"lang, wer welchen Gruppen geschrieben hat."

#: src/Ui/EmailView.php:181 src/Ui/EmailView.php:240
msgid "Replies go to"
msgstr "Antworten an"

#: src/Ui/EmailView.php:185
msgid ""
"Prefilled with your email address. Recipients' replies go to this address."
msgstr ""
"Vorausgefüllt mit deiner E-Mail-Adresse. Antworten der Empfänger gehen an "
"diese Adresse."

#: src/Ui/EmailView.php:195 src/Ui/EmailView.php:243
msgid "Message"
msgstr "Nachricht"

#: src/Ui/EmailView.php:197
msgid "Every recipient gets their own email."
msgstr "Alle Empfänger bekommen eine eigene E-Mail."

#: src/Ui/EmailView.php:201
msgid "Review"
msgstr "Prüfen"

#. translators: %d: number of recipients
#: src/Ui/EmailView.php:231
#, php-format
msgid "%d person"
msgid_plural "%d people"
msgstr[0] "%d Person"
msgstr[1] "%d Personen"

#: src/Ui/EmailView.php:235
msgid ""
"You get a copy that names you as the sender and lists the groups. The others "
"do not see the groups."
msgstr ""
"Du bekommst eine Kopie, die dich als Absender nennt und die Gruppen auflistet. "
"Die anderen sehen die Gruppen nicht."

#: src/Ui/EmailView.php:245 src/Ui/EmailView.php:339
msgid "Attachments"
msgstr "Anhänge"

#. translators: %d: number of recipients
#: src/Ui/EmailView.php:262
#, php-format
msgid "Send the email to %d person now?"
msgid_plural "Send the email to %d people now?"
msgstr[0] "Die E-Mail jetzt an %d Person senden?"
msgstr[1] "Die E-Mail jetzt an %d Personen senden?"

#: src/Ui/EmailView.php:270
msgid "Send"
msgstr "Senden"

#: src/Ui/EmailView.php:276
msgid "Edit"
msgstr "Bearbeiten"

#: src/Ui/EmailView.php:287
msgid "Black"
msgstr "Schwarz"

#: src/Ui/EmailView.php:288
msgid "Gray"
msgstr "Grau"

#: src/Ui/EmailView.php:289
msgid "Red"
msgstr "Rot"

#: src/Ui/EmailView.php:290
msgid "Orange"
msgstr "Orange"

#: src/Ui/EmailView.php:291
msgid "Green"
msgstr "Grün"

#: src/Ui/EmailView.php:292
msgid "Blue"
msgstr "Blau"

#: src/Ui/EmailView.php:293
msgid "Purple"
msgstr "Lila"

#: src/Ui/EmailView.php:354
msgid "Add attachments"
msgstr "Anhänge hinzufügen"

#. translators: 1: maximum number of files, 2: maximum size, e.g. "10 MB"
#: src/Ui/EmailView.php:357
#, php-format
msgid ""
"Up to %1$d files with %2$s in total, e.g. PDF, images or Office documents."
msgstr ""
"Bis zu %1$d Dateien mit insgesamt %2$s, z. B. PDF, Bilder oder Office-"
"Dokumente."

#. translators: date format, see https://www.php.net/manual/datetime.format.php; German: j. F Y
#: src/Ui/EmailView.php:387
msgid "F j, Y"
msgstr "j. F Y"

#. translators: time format, see https://www.php.net/manual/datetime.format.php; German: H:i
#: src/Ui/EmailView.php:389
msgid "g:i a"
msgstr "H:i"

