#, php-format
msgid "Sent by %1$s via %2$s to: %3$s"
msgstr "Gesendet von %1$s über %2$s an: %3$s"

#: src/Plugin.php:121
msgid "Write to members and project participants."
msgstr "Schreibe an Mitglieder und Projektteilnehmer."

#: src/Plugin.php:132
msgid "Email attachments"
msgstr "E-Mail-Anhänge"

#: src/Plugin.php:181
msgid ""
"Orchestra Email needs Orchestra Core 0.7 or later. Please update Orchestra "
"Core; until then, Orchestra Core sends the emails itself."
msgstr ""
"Orchestra Email braucht Orchestra Core 0.7 oder neuer. Bitte aktualisiere "
"Orchestra Core; bis dahin verschickt Orchestra Core die E-Mails selbst."

#: src/Plugin.php:185
msgid "Orchestra Email needs Orchestra Core. Please install and activate it."
msgstr ""
"Orchestra Email braucht Orchestra Core. Bitte installiere und aktiviere es."

#: src/SenderName.php:38
msgid "Orchestra"
msgstr "Orchester"

#: src/Ui/AutomaticEmailsController.php:45
msgid "You are not allowed to change this email."
msgstr "Du darfst diese E-Mail nicht ändern."

#: src/Ui/AutomaticEmailsController.php:50
msgid "The default text is used again."
msgstr "Es wird wieder der Standardtext verwendet."

#: src/Ui/AutomaticEmailsController.php:66
msgid "The text has been saved."
msgstr "Der Text wurde gespeichert."

#: src/Ui/AutomaticEmailsView.php:46
msgid "There are no automatic emails you may change."
msgstr "Es gibt keine automatischen E-Mails, die du ändern darfst."

#: src/Ui/AutomaticEmailsView.php:50
msgid ""
"The system sends these emails by itself. Members can turn them off in their "
"profile."
msgstr ""
"Diese E-Mails verschickt das System von selbst. Mitglieder können sie in "
"ihrem Profil abschalten."

#: src/Ui/AutomaticEmailsView.php:67 src/Ui/AutomaticEmailsView.php:81
msgid "Sender name"
msgstr "Absendername"

#: src/Ui/AutomaticEmailsView.php:69 src/Ui/AutomaticEmailsView.php:112
msgid "Changed"
msgstr "Geändert"

#: src/Ui/AutomaticEmailsView.php:70 src/Ui/AutomaticEmailsView.php:113
msgid "Default"
msgstr "Standard"

#: src/Ui/AutomaticEmailsView.php:72
msgid ""
"Recipients see this name as the sender of all emails sent from here, written "
"or automatic. Replies still go to the reply address."
msgstr ""
"Empfänger sehen diesen Namen als Absender aller E-Mails, die von hier "
"verschickt werden, geschrieben oder automatisch. Antworten gehen weiterhin "
"an die Antwortadresse."

#: src/Ui/AutomaticEmailsView.php:86 src/Ui/AutomaticEmailsView.php:141
msgid "Save"
msgstr "Speichern"

#. translators: %s: default sender name, e.g. "Orchestra"
#: src/Ui/AutomaticEmailsView.php:91
#, php-format
msgid "Reset to \"%s\""
msgstr "Auf „%s“ zurücksetzen"

