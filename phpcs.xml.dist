<?xml version="1.0"?>
<ruleset name="Orchestra">
    <description>PSR-12 coding standard for Orchestra plugins.</description>

    <file>src</file>
    <file>tests</file>
    <file>orchestra-email.php</file>
    <file>uninstall.php</file>

    <!-- Fakes of WordPress globals cannot follow PSR-1 naming. -->
    <exclude-pattern>tests/Fakes/*</exclude-pattern>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>
</ruleset>
