{
    "name": "orchestra/email",
    "description": "Emails to members, sections and project participants for the Orchestra plugin suite.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/TheRacoonOfDeath/orchestra-core"
        }
    ],
    "require": {
        "php": "^8.3",
        "yahnis-elsts/plugin-update-checker": "^5.7"
    },
    "require-dev": {
        "orchestra/core": "^0.7",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Orchestra\\Email\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orchestra\\Email\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "fix": "phpcbf",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
